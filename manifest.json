{
  "manifest_version": 3,
  "name": "FanDeck",
  "version": "1.3.1",
  "description": "Every game. One screen. Bring your playing tabs together with automatic player detection and instant audio switching.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "scripting"],
  "icons": { "16": "extension/icons/fandeck-16.png", "32": "extension/icons/fandeck-32.png", "48": "extension/icons/fandeck-48.png", "128": "extension/icons/fandeck-128.png" },
  "action": { "default_title": "Add this tab to FanDeck", "default_icon": { "16": "extension/icons/fandeck-16.png", "32": "extension/icons/fandeck-32.png" } },
  "background": { "service_worker": "extension/background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
